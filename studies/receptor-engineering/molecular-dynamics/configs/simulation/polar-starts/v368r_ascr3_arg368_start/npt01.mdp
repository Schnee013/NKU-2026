cutoff-scheme = Verlet
nstlist = 20
rlist = 1.2
vdwtype = Cut-off
vdw-modifier = Force-switch
rvdw_switch = 1.0
rvdw = 1.2
coulombtype = PME
rcoulomb = 1.2
pbc = xyz
define = -DPOSRES -DPOSRES_FC_BB=1000 -DPOSRES_FC_SC=500 -DPOSRES_FC_LIPID=400 -DPOSRES_FC_LIG=100 -DDIHRES -DDIHRES_FC=200
refcoord_scaling = all
integrator = md
dt = 0.001
nsteps = 125000
tinit = 125
continuation = yes
gen_vel = no
constraints = h-bonds
constraint_algorithm = LINCS
lincs_order = 4
lincs_iter = 2
tcoupl = v-rescale
tc_grps = SOLU MEMB SOLV
tau_t = 1 1 1
ref_t = 303.15 303.15 303.15
pcoupl = C-rescale
pcoupltype = semiisotropic
tau_p = 5
compressibility = 4.5e-5 4.5e-5
ref_p = 1 1
nstcomm = 100
comm_mode = linear
comm_grps = System
nstxout = 0
nstvout = 0
nstfout = 0
nstxout-compressed = 10000
nstenergy = 1000
nstlog = 10000
nstcalcenergy = 100
