define = -DPOSRES -DPOSRES_FC_BB=1000 -DPOSRES_FC_SC=500 -DPOSRES_FC_LIPID=400 -DPOSRES_FC_LIG=100 -DDIHRES -DDIHRES_FC=400
cutoff-scheme = Verlet
nstlist = 20
rlist = 1.2
vdwtype = Cut-off
vdw-modifier = Force-switch
rvdw_switch = 1.0
rvdw = 1.2
coulombtype = PME
rcoulomb = 1.2
pbc = xyz
integrator = md
dt = 0.001
constraints = h-bonds
constraint_algorithm = LINCS
lincs_order = 4
lincs_iter = 2
nstxout-compressed = 1000
nstenergy = 500
nstlog = 500
nstcalcenergy = 100
tcoupl = v-rescale
tc_grps = SOLU MEMB SOLV
tau_t = 1.0 1.0 1.0
ref_t = 303.15 303.15 303.15
pcoupl = no
nstcomm = 100
comm_mode = linear
comm_grps = System
nsteps = 75000
tinit = 50
gen_vel = no
continuation = yes
